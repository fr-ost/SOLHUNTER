# =============================================================================
# SolHunter - environment variables (copy to .env for local development)
# NEVER commit a real .env. On Railway set these as service variables.
# Column "Service": api = solhunter-api, scanner = solhunter-scanner, both = both
# =============================================================================

# --- Application (both) -------------------------------------------------------
APP_ENV=development                 # development | test | production
SERVICE_ROLE=all                    # all = API + dashboard + scanner in one process (default) | api | scanner
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json (Railway) | console (local)
PORT=8080                           # Railway injects PORT automatically for the API service
PUBLIC_API_BASE_URL=                # e.g. https://solhunter-production.up.railway.app
DASHBOARD_BASE_URL=                 # optional link base used in Telegram alerts (scanner)

# --- Database & Redis (both) --------------------------------------------------
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  REDIS_URL=${{Redis.REDIS_URL}} (private network)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solhunter
REDIS_URL=redis://localhost:6379/0
RUN_MIGRATIONS_ON_START=true        # advisory-locked; set false only on a separate scanner-only service
MIGRATION_WAIT_TIMEOUT_SECONDS=180  # scanner waits this long for the api to migrate the schema
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- API security (api) -------------------------------------------------------
PASSWORD=change-me                  # dashboard login password (also allows changing settings). Any text.
API_KEYS=                           # optional extra read-only keys, comma separated (advanced)
API_ADMIN_KEYS=                     # optional extra admin keys, comma separated (advanced)
CORS_ALLOWED_ORIGINS=               # extra comma separated origins (the built-in dashboard is same-origin, needs none)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
WS_MAX_CONNECTIONS=50

# --- Providers (scanner; api only needs them for optional on-demand lookups) --
PUMPPORTAL_ENABLED=true
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_MAX_TRADE_SUBSCRIPTIONS=250
DEXSCREENER_ENABLED=true
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPM_PAIRS=300           # documented limit for pairs/search/token-pairs/tokens endpoints
DEXSCREENER_RPM_OTHER=60            # documented limit for profiles/boosts/orders endpoints
HELIUS_ENABLED=true
HELIUS_API_KEY=                     # https://dashboard.helius.dev (free tier: 1M credits/month, 10 RPC rps)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_API_BASE_URL=https://api.helius.xyz
HELIUS_RPC_RPS=10
HELIUS_ENHANCED_RPS=2
HELIUS_DAILY_CREDIT_BUDGET=30000
HELIUS_MONTHLY_CREDIT_BUDGET=1000000
SOLANA_FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com
SOL_USD_FALLBACK_PRICE=             # optional; only used when no live SOL price is available

# --- OpenAI GPT research analyst (scanner) ------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=                    # leave empty for api.openai.com
AI_ENABLED=true
AI_MODEL=gpt-5.6                    # verified at start-up; NOT silently substituted if unavailable
AI_VERIFY_MODEL_ON_START=true
AI_REASONING_EFFORT=                # optional (low|medium|high) if supported by the model
AI_MAX_OUTPUT_TOKENS=3000
AI_TIMEOUT_SECONDS=90
AI_INPUT_COST_PER_1M_USD=2.50       # PLACEHOLDER pricing - set to current OpenAI pricing for AI_MODEL
AI_OUTPUT_COST_PER_1M_USD=10.00     # PLACEHOLDER pricing - set to current OpenAI pricing for AI_MODEL
AI_DAILY_SPEND_LIMIT_USD=1.50
AI_MONTHLY_SPEND_LIMIT_USD=25
AI_MAX_ANALYSES_PER_DAY=60
AI_MAX_ANALYSES_PER_TOKEN=2
AI_CACHE_TTL_SECONDS=900

# --- Telegram (scanner) -------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=                 # from @BotFather
TELEGRAM_CHAT_ID=                   # your chat / channel id
TELEGRAM_ALERT_MIN_SCORE=72
TELEGRAM_SEND_WATCHLIST=false
TELEGRAM_COOLDOWN_SECONDS=1800
TELEGRAM_URGENT_COOLDOWN_SECONDS=600
TELEGRAM_MAX_ALERTS_PER_HOUR=10

# --- Scanner behaviour (scanner) ----------------------------------------------
SCANNER_MAX_TRACKED_TOKENS=250
SCANNER_TRACK_DURATION_MINUTES=90
SCANNER_SNAPSHOT_SCHEDULE_MINUTES=1,3,5,10,15
SCANNER_PERIODIC_SNAPSHOT_INTERVAL_SECONDS=60
SCANNER_HEARTBEAT_INTERVAL_SECONDS=15
SCANNER_STALE_AFTER_SECONDS=90
SCANNER_HTTP_HEALTH_ENABLED=true
SCANNER_HTTP_HEALTH_PORT=8081       # Railway: leave PORT unset for the scanner or set it to this value
SCANNER_MIN_FIRST_MINUTE_TRADES=3
SCANNER_OUTCOME_HORIZON_MINUTES=60

# --- Filtering thresholds (scanner; all overridable at runtime via the API) ---
FILTER_MIN_LIQUIDITY_USD=4000
FILTER_MIN_LIQUIDITY_SOL=15
FILTER_MAX_LARGEST_HOLDER_PCT=0.12
FILTER_MAX_TOP10_PCT=0.40
FILTER_MAX_TOP20_PCT=0.55
FILTER_MAX_DEV_HOLDING_PCT=0.10
FILTER_MIN_HOLDERS=40
FILTER_MIN_UNIQUE_BUYERS_5M=12
FILTER_MAX_SELL_IMPACT_PCT_AT_REFERENCE_SIZE=0.08
FILTER_REFERENCE_TRADE_SIZE_USD=250
FILTER_MAX_CREATOR_PRIOR_RUGS=0
FILTER_MAX_RUG_RISK=0.45
FILTER_MIN_BREAKOUT_P10=0.25

# --- Ranking (scanner) --------------------------------------------------------
RANK_CANDIDATE_MIN_SCORE=68
RANK_WATCHLIST_MIN_SCORE=52
RANK_GPT_MIN_SCORE=65
RANK_ALERT_MIN_SCORE=72
RANK_MAX_CANDIDATES_PER_HOUR=6

# --- Execution / risk reference settings (both) --------------------------------
EXEC_TRADE_SIZES_USD=100,250,500
EXEC_PUMP_FEE_BPS=100
EXEC_AMM_FEE_BPS=25
EXEC_PRIORITY_FEE_SOL=0.0005
RISK_ACCOUNT_EQUITY_USD=500
RISK_PER_TRADE_PCT=1
RISK_DAILY_LOSS_LIMIT_PCT=2.5
RISK_MAX_OPEN_POSITIONS=2
RISK_STOP_LOSS_PCT=6
RISK_TARGET_PCTS=10,15,20

# --- ML (scanner) -------------------------------------------------------------
ML_AUTO_TRAIN_ENABLED=true
ML_MIN_TRAINING_SAMPLES=400
ML_MIN_POSITIVE_SAMPLES=25
ML_RETRAIN_INTERVAL_HOURS=24
ML_EXPERIMENTAL_UNTIL_SAMPLES=1500
ML_FEE_AND_SLIPPAGE_PCT=3.0

# --- Retention (scanner) ------------------------------------------------------
RETENTION_RAW_EVENTS_DAYS=3
RETENTION_TRANSACTIONS_DAYS=30
RETENTION_WALLET_TRANSACTIONS_DAYS=30
RETENTION_SNAPSHOTS_DAYS=45         # prunes ONLY unlabelled, unscored snapshots; training data is always kept (0 = never prune)

# --- Cost display (api) -------------------------------------------------------
COST_RAILWAY_ESTIMATE_USD_MONTH=20
COST_HELIUS_PLAN_USD_MONTH=0
